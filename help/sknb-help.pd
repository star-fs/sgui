#N canvas 120 80 730 616 12;
#X text 20 10 sknb - a knob;
#X text 20 32 drag up and down to turn it.;
#X text 20 50 everything here is also a message you can send it.;
#X text 20 68 an empty send/receive/label is the symbol empty.;
#X text 20 86 colors are #rrggbb.;
#X obj 30 149 r \$0-sgui;
#X obj 30 179 sknb 32 32 0 127 0 0 empty empty empty 0 -8 0 8 #fcfcfc #000000 #000000 0 1;
#X connect 5 0 6 0;
#X floatatom 30 236 8 0 0 0 - - -;
#X connect 6 0 7 0;
#X text 30 271 set it up with the boxes on the right \, then copy this sknb into your patch: it keeps its settings., f 32;
#X text 30 346 in pd-vanilla the object's own properties dialog (right-click > Properties) does all this too. the color pickers are ELSE's [colors] for PlugData (which bundles ELSE): without ELSE they can't be created - type #rrggbb colors instead., f 32;
#X text 30 476 PlugData doesn't show the properties of pdlua objects (which these are in PlugData) in its inspector yet: configure the example here \, then copy and paste it from this help patch into yours., f 32;
#X text 290 125 properties (sent to the example as messages):;
#X text 290 149 size;
#X floatatom 440 149 6 0 0 0 - \$0-size-1-set \$0-size-1;
#X text 290 177 range (min max);
#X floatatom 440 177 6 0 0 0 - \$0-range-1-set \$0-range-1;
#X floatatom 503 177 6 0 0 0 - \$0-range-2-set \$0-range-2;
#X text 290 205 logarithmic;
#X obj 440 205 tgl 15 0 \$0-scale-1 \$0-scale-1-set empty 17 7 0 10 #fcfcfc #000000 #000000 0 1;
#X text 290 233 steady on click;
#X obj 440 233 tgl 15 0 \$0-steady-1 \$0-steady-1-set empty 17 7 0 10 #fcfcfc #000000 #000000 0 1;
#X text 290 261 init (keep value);
#X obj 440 261 tgl 15 0 \$0-init-1 \$0-init-1-set empty 17 7 0 10 #fcfcfc #000000 #000000 0 1;
#X text 290 289 colors: bg fg label;
#X symbolatom 440 289 9 0 0 0 - \$0-color-1-set \$0-color-1;
#X symbolatom 527 289 9 0 0 0 - \$0-color-2-set \$0-color-2;
#X symbolatom 614 289 9 0 0 0 - \$0-color-3-set \$0-color-3;
#X text 290 317 pick (PlugData);
#N canvas 0 0 450 200 pick 0;
#X obj 20 20 inlet;
#X obj 20 60 s \$0-color-1;
#X obj 160 20 inlet;
#X obj 160 60 s \$0-color-2;
#X obj 300 20 inlet;
#X obj 300 60 s \$0-color-3;
#X connect 0 0 1 0;
#X connect 2 0 3 0;
#X connect 4 0 5 0;
#X restore 440 347 pd pick;
#X f 30;
#X obj 440 317 else/colors;
#X connect 29 0 28 0;
#X obj 527 317 else/colors;
#X connect 30 0 28 1;
#X obj 614 317 else/colors;
#X connect 31 0 28 2;
#X text 290 373 label;
#X symbolatom 440 373 9 0 0 0 - \$0-label-1-set \$0-label-1;
#X text 290 401 label x y;
#X floatatom 440 401 6 0 0 0 - \$0-lpos-1-set \$0-lpos-1;
#X floatatom 503 401 6 0 0 0 - \$0-lpos-2-set \$0-lpos-2;
#X text 290 429 font \, size;
#X floatatom 440 429 6 0 0 0 - \$0-lfont-1-set \$0-lfont-1;
#X floatatom 503 429 6 0 0 0 - \$0-lfont-2-set \$0-lfont-2;
#X text 290 457 send symbol;
#X symbolatom 440 457 9 0 0 0 - \$0-send-1-set \$0-send-1;
#X text 290 485 receive symbol;
#X symbolatom 440 485 9 0 0 0 - \$0-receive-1-set \$0-receive-1;
