#N canvas 120 80 730 517 12;
#X text 20 10 stgl - a toggle drawn as a rectangle in a box;
#X text 20 32 outputs its nonzero value or 0 when clicked.;
#X text 20 50 everything here is also a message you can send it.;
#X text 20 68 an empty send/receive/label is the symbol empty.;
#X text 20 86 colors are #rrggbb.;
#X obj 30 149 r \$0-sgui;
#X obj 30 179 stgl 15 15 0 empty empty empty 17 7 0 10 #fcfcfc #000000 #000000 0 1;
#X connect 5 0 6 0;
#X floatatom 30 219 8 0 0 0 - - -;
#X connect 6 0 7 0;
#X text 30 254 set it up with the boxes on the right \, then copy this stgl into your patch: it keeps its settings., f 32;
#X text 30 329 in pd-vanilla the object's own properties dialog (right-click > Properties) does all this too. the color pickers are ELSE's [colors] for PlugData (which bundles ELSE): without ELSE they can't be created - type #rrggbb colors instead., f 32;
#X text 290 125 properties (sent to the example as messages):;
#X text 290 149 size (w h);
#X floatatom 440 149 6 0 0 0 - \$0-size-1-set \$0-size-1;
#X floatatom 503 149 6 0 0 0 - \$0-size-2-set \$0-size-2;
#X text 290 177 nonzero value;
#X floatatom 440 177 6 0 0 0 - \$0-nonzero-1-set \$0-nonzero-1;
#X text 290 205 init (keep state);
#X obj 440 205 tgl 15 0 \$0-init-1 \$0-init-1-set empty 17 7 0 10 #fcfcfc #000000 #000000 0 1;
#X text 290 233 colors: bg fg label;
#X symbolatom 440 233 9 0 0 0 - \$0-color-1-set \$0-color-1;
#X symbolatom 527 233 9 0 0 0 - \$0-color-2-set \$0-color-2;
#X symbolatom 614 233 9 0 0 0 - \$0-color-3-set \$0-color-3;
#X text 290 261 pick (PlugData);
#N canvas 0 0 450 200 pick 0;
#X obj 20 20 inlet;
#X obj 20 60 s \$0-color-1;
#X obj 160 20 inlet;
#X obj 160 60 s \$0-color-2;
#X obj 300 20 inlet;
#X obj 300 60 s \$0-color-3;
#X connect 0 0 1 0;
#X connect 2 0 3 0;
#X connect 4 0 5 0;
#X restore 440 291 pd pick;
#X f 30;
#X obj 440 261 else/colors;
#X connect 24 0 23 0;
#X obj 527 261 else/colors;
#X connect 25 0 23 1;
#X obj 614 261 else/colors;
#X connect 26 0 23 2;
#X text 290 317 label;
#X symbolatom 440 317 9 0 0 0 - \$0-label-1-set \$0-label-1;
#X text 290 345 label x y;
#X floatatom 440 345 6 0 0 0 - \$0-lpos-1-set \$0-lpos-1;
#X floatatom 503 345 6 0 0 0 - \$0-lpos-2-set \$0-lpos-2;
#X text 290 373 font \, size;
#X floatatom 440 373 6 0 0 0 - \$0-lfont-1-set \$0-lfont-1;
#X floatatom 503 373 6 0 0 0 - \$0-lfont-2-set \$0-lfont-2;
#X text 290 401 send symbol;
#X symbolatom 440 401 9 0 0 0 - \$0-send-1-set \$0-send-1;
#X text 290 429 receive symbol;
#X symbolatom 440 429 9 0 0 0 - \$0-receive-1-set \$0-receive-1;
#X text 290 467 the messages are built in here:;
#N canvas 100 100 1770 850 logic 0;
#X obj 20 20 loadbang;
#X msg 20 60 set 15;
#X obj 20 85 s \$0-size-1-set;
#X connect 0 0 1 0;
#X connect 1 0 2 0;
#X msg 20 115 set 15;
#X obj 20 140 s \$0-size-2-set;
#X connect 0 0 3 0;
#X connect 3 0 4 0;
